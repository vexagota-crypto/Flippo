# Flippo Environment Configuration Example

# Network Mode: testnet | mainnet
NEXT_PUBLIC_NETWORK_MODE=testnet

# Privy Auth (Client & Server)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_SERVER_WALLET_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Robinhood Chain (RH)
NEXT_PUBLIC_RH_CHAIN_ID=4663
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER_URL=https://robinhoodchain.blockscout.com/

# $FLIPPO Token
NEXT_PUBLIC_FLIPPO_TOKEN_ADDRESS=COMING_SOON

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Admin Wallets (comma-separated, optional)
ADMIN_WALLETS=

# Cron Secret for automated ledger / budget checks
CRON_SECRET=

# Social Links
NEXT_PUBLIC_TWITTER_URL=https://x.com/flippocoin
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/flippocoin
NEXT_PUBLIC_DOCS_URL=https://docs.flippo.fun

# App URL / Allowed Dev Origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
